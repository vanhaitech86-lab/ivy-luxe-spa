# Sao chép file này thành .env.local (chạy trên máy) hoặc nhập từng biến vào Vercel → Settings → Environment Variables.
# Không gửi file có khoá thật cho người khác, không đưa lên GitHub.

# Kho dữ liệu (Upstash Redis): BẮT BUỘC khi chạy trên Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Khoá ký phiên đăng nhập: chuỗi ngẫu nhiên dài (khuyên dùng)
SESSION_SECRET=

# Gửi thư xác nhận đăng ký (mật khẩu ứng dụng Gmail 16 ký tự)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bot AI tư vấn: chọn 1 trong 2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=

# Bot Telegram
TELEGRAM_BOT_TOKEN=
NOTIFY_BOT_TOKEN=

# Thêm Gmail Chủ Spa (cách nhau dấu phẩy)
OWNER_EMAILS=
